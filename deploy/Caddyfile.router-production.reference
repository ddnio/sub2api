# Router 生产环境 production snapshot 2026-09-07; compare live config before use.
# Never overwrite unrelated live sites. No reload is performed by this file.
fx.nanafox.com, router.nanafox.com {


	@static {
		path /assets/*
		path /logo.png
		path /favicon.ico
	}
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
		-Pragma
		-Expires
	}

	tls {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
	}


    handle_path /tools/image-playground/* {
        header {
            Cache-Control "no-store"
            Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' data: blob:; font-src 'self' data:; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "SAMEORIGIN"
        }
        root * /srv/nanafox/image-playground/prod-current
        try_files {path} /index.html
        file_server
    }
    handle_path /migration-assets/* {
        root * /srv/nanafox/fx-web-assets
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

	reverse_proxy 127.0.0.1:18080 {
		health_uri /health
		health_interval 30s
		health_timeout 10s
		health_status 200
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		transport http {
			keepalive 120s
			keepalive_idle_conns 256
			compression off
		}
		# 单后端不启用被动摘除，仅依赖主动健康检查
	}

	encode {
		zstd
		gzip 6
		minimum_length 256
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	request_body {
		max_size 100MB
	}

	log {
		output file /var/log/caddy/sub2api-fx.log {
			roll_size 50mb
			roll_keep 10
		}
		format json
		level INFO
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}


llm.nanafox.com {
	reverse_proxy localhost:4000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	request_body {
		max_size 50MB
	}

	log {
		output file /var/log/caddy/litellm.log {
			roll_size 50mb
			roll_keep 10
		}
		format json
		level INFO
	}
}
# grok.nanafox.com -> grok2api trial service
# Source/runtime directory: /data/service/grok2api
# Container: cli-proxy-api, host bind: 127.0.0.1:8317, Docker network: deploy_sub2api-network
# Admin/WebUI are temporarily public for initial account setup.

grok.nanafox.com {
	reverse_proxy localhost:8317 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			keepalive 120s
			keepalive_idle_conns 128
			compression off
		}
	}

	request_body {
		max_size 100MB
	}

	log {
		output file /var/log/caddy/grok2api-grok.log {
			roll_size 50mb
			roll_keep 10
		}
		format json
		level INFO
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}


studio-fx.nanafox.com, studio.nanafox.com {
    reverse_proxy 127.0.0.1:18789 {
        health_uri /api/ready
        health_interval 30s
        health_timeout 10s
        header_up X-Real-IP {remote_host}
        transport http {
            response_header_timeout 600s
        }
    }
    encode zstd gzip
    request_body {
        max_size 100MB
    }
    log {
        output file /var/log/caddy/studio-fx.log {
            roll_size 20mb
            roll_keep 3
        }
        format json
    }
}


# NanaFox landing: original deployed static release c63fc7e7beb7ec3010a1f223dcd5bd7927c645fb
nanafox.com, www.nanafox.com {
    tls {
        protocols tls1.2 tls1.3
    }
    root * /srv/nanafox-landing/current
    file_server
    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}
